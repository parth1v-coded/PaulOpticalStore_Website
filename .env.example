# Copy this file to a new file named ".env" (same folder) and replace the placeholders with your own values.
# ".env" is listed in .gitignore, so it is never uploaded. NEVER commit real keys or passwords.

# Needed only for the "Ask about prices" chatbot. Get a free key at https://aistudio.google.com/apikey
# (the rest of the website works without it)
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Password for the owner's inbox page at /admin. Choose a long one (12+ characters).
# If you leave this out, a strong random password is generated and saved in admin_password.txt on first run.
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

# Optional: any Gemini model your key can use (default gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite
